---
source: crates/prybar-export/tests/qc/main.rs
expression: "files[0].text"
---
$modelname "prybar/test.mdl"
$cdmaterials "models/prybar/"
$surfaceprop "metal"
$staticprop
$illumposition 0 0 0
$eyeposition 0 0 64
$cbox -1 -1 -1 1 1 1
$includemodel "prybar/anims.mdl"
$keyvalues
{
prop_data
{
"base" "Metal.Small"
}
}
$model "head" "face.smd" {
  flexfile "face.vta" {
    defaultflex frame 0
    flexpair "smile" 1 frame 1
    flex "blink" frame 2
  }
  eyeball "eye_right" "head" 2 2 3 "eyeball_r" 1 3.998471 "iris_unused" 1
  flexcontroller phoneme range 0 1 smile
  flexcontroller eyes range 0 1 blink
  flexcontroller default range -1 1 lr
  %smileL = smile * (2 - lr)
  %smileR = -(max(smile, blink))
  %blink = ((min(max(-lr, 0), 1)) * (min(max(lr, 0), 1))) * (1 - (blink))
  %blink = (0 + 0) * (0)
}
$bodygroup "hats" {
  studio "hat.smd"
  blank
}
$lod 10 {
  replacemodel "hat.smd" "hat_lod1.smd"
}
$texturegroup "skinfamilies"
{
  { "skin_a" }
  { "skin_b" }
}

$definebone "root" "" 0 0 0 90 0 0 0 0 0 0 0 0
$definebone "head" "root" 1 0 0 90 0 0 0 0 0 0 0 0
$definebone "tail" "head" 3 0 0 90 0 0 0 0 0 0 0 0
$bonemerge "head"
$jointsurfaceprop "head" "flesh"
$attachment "eyes" "head" 1 2 3 rotate 0 0 0 world_align
$hboxset "default"
$hbox 1 "head" -1 -1 -1 1 1 1

$jigglebone "tail" {
  is_flexible {
    length 5
    tip_mass 0.5
    yaw_stiffness 0
    yaw_damping 0
    pitch_stiffness 0
    pitch_damping 0
    along_stiffness 0
    along_damping 0
    yaw_constraint -28.64789 28.64789
    yaw_friction 0
    yaw_bounce 0
    allow_length_flex
  }
  is_boing {
    impact_speed 0
    impact_angle 60.000004
    damping_rate 0
    frequency 0
    amplitude 0
  }
}

$poseparameter "move_x" -1 1
$weightlist "weights_0" {
  "root" 1
  "head" 0.5
  "tail" 0
}
$animation "a_walk" "walk.smd" {
  fps 30
  loop
  walkframe 10 LX LY
}
// a_gesture: no decoded frames (missing .ani?)
$sequence "walk" {
  "a_walk" "a_gesture"
  blend "move_x" -1 1
  loop
  activity "ACT_WALK" 1
  fadein 0.2
  fadeout 0.2
  transition "1" "2"
  keyvalues
  {
"faceposer" { }
  }
  { event AE_FOOTSTEP 5 "Foot.Step" }
  blendlayer "gesture" 0 0.1 0.9 1 spline poseparameter "move_x"
  weightlist "weights_0"
}
$sequence "gesture" {
  "a_gesture"
  predelta
  fadein 0
  fadeout 0
  posecycle "move_x"
  addlayer "walk"
  weightlist "weights_0"
}

$collisionjoints "test_physics.smd" {
  $mass 90
  $concave
  $concaveperjoint
  $rootbone "root"
  $noselfcollisions
  $jointdamping "root" 0.1
  $jointrotdamping "root" 0
  $jointinertia "head" 2
  $jointconstrain "head" x limit -30 30 0.5
  $jointconstrain "head" y limit 0 0 0
  $jointconstrain "head" z limit 0 0 0
}
